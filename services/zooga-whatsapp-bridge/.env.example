# ZOOGA OS WhatsApp Web bridge — environment template.
# NEVER commit a filled .env. These values are secrets and must never be stored
# in Supabase/Lovable tables or returned by any endpoint.

# Inbound auth from the Zooga OS control plane (min 24 chars, random).
BRIDGE_API_KEY=replace-with-long-random-string

# Optional, reserved for future control-plane callbacks (HMAC signing).
# CONTROL_PLANE_CALLBACK_SECRET=

# Persistent volume paths.
DATA_DIR=/data
SESSION_DIR=/data/session

PORT=8080

# Optional hardening.
TRUST_PROXY=true
# ALLOWED_ORIGIN=https://your-zooga-os-domain

# Sending safety (group-only sending).
MIN_SEND_INTERVAL_MS=2000
MAX_SENDS_PER_MINUTE=20
SEND_JITTER=true

# QR is memory-only; this is just its TTL.
QR_TTL_MS=60000

# Idempotency ledger retention (7 days).
IDEMPOTENCY_TTL_MS=604800000

MAX_TEXT_LENGTH=4000
MAX_MEDIA_BYTES=10485760
MEDIA_TIMEOUT_MS=15000
